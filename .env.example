# Copy this file to .env at the repository root. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=stock_prediction

# Required for data collection; obtain your own Tushare Pro token.
TUSHARE_TOKEN=
# Leave empty to use the SDK default. Only use a gateway you trust.
TUSHARE_API_URL=
